config {
  type: "operation",
  name: "fleetcard_ga4_bq_funneldata_v2",
  description: "Daily refresh: Delete and re-insert last 3 days of funnel data to handle late-arriving GA4 data",
  tags: ["daily", "fleetcard", "funnel_analysis"],
  hasOutput: true
}

BEGIN
  -- Delete last 3 days of data
  DELETE FROM analytics_330455754.fleetcard_ga4_bq_funneldata_v2
  WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY);

  -- Re-insert last 3 days with full funnel logic
  INSERT INTO analytics_330455754.fleetcard_ga4_bq_funneldata_v2
  WITH base AS (
    SELECT
      continent,
      country,
      session_source,
      session_medium,
      session_source_medium,
      session_channel_group,
      session_campaign,
      c_funnel,
      c_page_referrer,
      device_category,
      c_event_label,
      landing_page,
      hostname,
      c_page_location,
      c_event_name,
      event_date,
      user_pseudo_id,
      session_id,
      c_event_action,
      c_region,
      c_funnel_variant,
      browser,
      product_type_filter
    FROM analytics_330455754.Fleetcard_SessionLevelData_v2
    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY)
  ),

  stages AS (
    SELECT
      *,
      1 AS Stage_order,
      "Lead Gen" as Funnel_type,
      "LeadFunnelLoad" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%fleetSize%'

    UNION ALL
    SELECT
      *,
      2 AS Stage_order,
      "Lead Gen" as Funnel_type,
      "BusinessType" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%businessType/%'

    UNION ALL
    SELECT
      *,
      3 AS Stage_order,
      "Lead Gen" as Funnel_type,
      "FuelManagement" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%fuelManagement/%'

    UNION ALL
    SELECT
      *,
      4 AS Stage_order,
      "Lead Gen" as Funnel_type,
      "FleetSize" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%fleetSize/%'

    UNION ALL
    SELECT
      *,
      5 AS Stage_order,
      "Lead Gen" as Funnel_type,
      "Benefits" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%benefits/%'

    UNION ALL
    SELECT
      *,
      6 AS Stage_order,
      "Lead Gen" as Funnel_type,
      "Fuel Expenditure" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%expenditure/%'

    UNION ALL
    SELECT
      *,
      7 AS Stage_order,
      "Lead Gen" as Funnel_type,
      "Lead" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%success%'

    UNION ALL
    SELECT
      *,
      11 AS Stage_order,
      "E2E" as Funnel_type,
      "Funnel Load (All Pages)" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%splash/splash%'

    UNION ALL
    SELECT
      *,
      12 AS Stage_order,
      "E2E" as Funnel_type,
      "Application Start Screen" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%FunnelOpen%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      13 AS Stage_order,
      "E2E" as Funnel_type,
      "Application Started" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%virtualPageview/business-details%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      14 AS Stage_order,
      "E2E" as Funnel_type,
      "Business Details Complete" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%business-details_continue%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      15 AS Stage_order,
      "E2E" as Funnel_type,
      "Applicant Details Complete" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%applicant_continue%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      16 AS Stage_order,
      "E2E" as Funnel_type,
      "Director Details Complete" AS Stage_complete
    FROM base
    WHERE (c_event_label LIKE '%directorOwner_continue%'
      OR c_event_label LIKE '%director-owner_continue%')
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      17 AS Stage_order,
      "E2E" as Funnel_type,
      "Requirements Complete" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%application-requirements_continue%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      18 AS Stage_order,
      "E2E" as Funnel_type,
      "Direct Debit Complete (Optional)" AS Stage_complete
    FROM base
    WHERE (c_event_label LIKE '%application-direct-debit%'
      OR c_event_label LIKE '%application-direct-debit_continue%')
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      19 AS Stage_order,
      "E2E" as Funnel_type,
      "Terms & Conditions Complete" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%application-terms-and-conditions_continue%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      20 AS Stage_order,
      "E2E" as Funnel_type,
      "Conditional Approval Complete (Optional)" AS Stage_complete
    FROM base
    WHERE (c_event_label LIKE '%conditionalApproval_continue%'
      OR c_event_label LIKE '%conditional-approval_continue%')
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      21 AS Stage_order,
      "E2E" as Funnel_type,
      "Offer Accepted" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%/offer-accepted_continue%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      22 AS Stage_order,
      "E2E" as Funnel_type,
      "Authority Access Complete" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%setup-authorities_continue%'
      AND c_funnel LIKE '%_e2e%'

    UNION ALL
    SELECT
      *,
      23 AS Stage_order,
      "E2E" as Funnel_type,
      "Card Setup Complete (Funnel Completion)" AS Stage_complete
    FROM base
    WHERE c_event_label LIKE '%/setup-delivery-address-cards_continue%'
      AND c_funnel LIKE '%_e2e%'
  )

  SELECT
    *,
    COUNT(DISTINCT user_pseudo_id) AS users,
    CASE
      WHEN LOWER(session_source_medium) LIKE '%dianomi%' THEN 'Dianomi'
      WHEN LOWER(session_source_medium) LIKE '%google / cpc%' THEN 'Google CPC'
      WHEN LOWER(session_source_medium) LIKE '%facebook%'
        OR LOWER(session_source_medium) LIKE '%fb / cpc%'
        OR LOWER(session_source_medium) LIKE '%ig / cpc%'
        OR LOWER(session_source_medium) LIKE '%an / cpc%' THEN 'Paid Social'
      WHEN LOWER(session_source_medium) LIKE '%bing / cpc%' THEN 'Bing CPC'
      WHEN LOWER(session_source_medium) LIKE '%organic%' THEN 'Organic'
      WHEN LOWER(session_source_medium) LIKE '%direct%' THEN 'Direct'
      WHEN LOWER(session_source_medium) LIKE '%email%' THEN 'Email'
      WHEN LOWER(session_source_medium) LIKE '%taboola%' THEN 'Taboola'
      WHEN LOWER(session_source_medium) LIKE '%plista%' THEN 'Plista'
      WHEN LOWER(session_source_medium) LIKE '%outbrain%' THEN 'Outbrain'
      WHEN LOWER(session_source_medium) LIKE '%affiliate%' THEN 'Affiliate'
      WHEN LOWER(session_source_medium) LIKE '%healthengine%' THEN 'Health Engine'
      WHEN LOWER(session_source_medium) LIKE '%edm%' THEN 'Email'
      WHEN LOWER(session_source_medium) LIKE '%referral%' THEN 'Referral'
      ELSE 'Other'
    END AS c_web_channel,
    CASE
      WHEN c_event_label LIKE '%trackStep/fleetSize/%' then REGEXP_EXTRACT(c_event_label,r'fleetSize\/([0-9]+\-[0-9]+|[0-9]{3}\+)\_')
    END AS c_fleet_size_bucket_filter,
    CASE
      WHEN c_event_label LIKE '%/Another%' THEN 'Another'
      WHEN c_event_label LIKE '%/Car allowance%' THEN 'Car allowance'
      WHEN c_event_label LIKE '%/Expense and claim%' THEN 'Expense and claim'
      WHEN c_event_label LIKE '%/None / other%' THEN 'None / other'
      ELSE 'Other'
    END AS c_fuel_management_filter,
    CASE
      WHEN c_event_label LIKE '%< $10,000%' THEN '<$10,000'
      WHEN c_event_label LIKE '%$10,000 - $50,000%' THEN '$10,000 - $50,000'
      WHEN c_event_label LIKE '%> $50,000%' THEN '>$50,000'
      ELSE 'Other'
    END AS c_fuel_expenditure_filter
  FROM stages s
  GROUP BY ALL;

  SELECT @@row_count as rows_inserted;
END
